# Square-Pot configuration template.
#
# Copy to `.env` next to this file and fill in the values. `.env` is ignored by
# git and must never be committed.
#
# Every environment variable a component reads is listed here, with a comment
# saying what it does and a safe placeholder or default. Add the variable in the
# same pull request that starts reading it.

# --- Server ---

# Token that the Android app and the bot send as "Authorization: Bearer <token>".
# Required, at least 16 characters. Generate one with: openssl rand -hex 32
SQUAREPOT_API_TOKEN=

# Collections: each is one tab of a Google Sheet, shared (as Viewer) with the
# service account's email. A JSON list; `id` is a short stable name in
# lower-case letters, digits, "-" or "_", and `spreadsheet_id` is the long id in
# the sheet's URL.
SQUAREPOT_COLLECTIONS='[{"id": "main", "name": "My plants", "spreadsheet_id": "PUT-THE-SPREADSHEET-ID-HERE", "sheet": "Plants"}]'

# How often to check the sheets for changes, in seconds. Each check is one
# cheap Drive call per collection; a changed tab is read with one Sheets call.
# 0 turns syncing off.
SQUAREPOT_SYNC_INTERVAL_SECONDS=60

# Database. The default is SQLite in the container's data volume.
# SQUAREPOT_DATABASE_URL=sqlite:////data/squarepot.db

# --- docker compose only ---

# Host file holding the service account's JSON key; it is passed to the server
# as a secret. Default: service-account.json next to compose.yaml.
# SQUAREPOT_GOOGLE_KEY_FILE=./service-account.json

# Address and port the API listens on, on the host. The default accepts local
# connections only; use 0.0.0.0:8000 to reach it from a phone on your network.
# Until HTTPS is set up, do not expose it to the internet.
# SQUAREPOT_LISTEN=127.0.0.1:8000
