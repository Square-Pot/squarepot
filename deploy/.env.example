# Square-Pot configuration template.
#
# Copy to `.env` next to this file and fill in the values. `.env` is ignored by
# git and must never be committed.
#
# Every environment variable a component reads is listed here, with a comment
# saying what it does and a safe placeholder or default. Add the variable in the
# same pull request that starts reading it.

# --- Server ---

# Token that the Android app and the bot send as "Authorization: Bearer <token>".
# Required, at least 16 characters. Generate one with: openssl rand -hex 32
SQUAREPOT_API_TOKEN=

# Where collections are read from:
#   "link"   (the default) a Google Sheet shared as "anyone with the link can
#            view", downloaded as CSV; needs no Google Cloud project. Anyone who
#            learns the sheet's id can read it, so keep the id private.
#   "google" a private Google Sheet shared with a service account's email: as
#            Viewer to read it, as Editor to add and edit plants from the
#            apps. Also set COMPOSE_FILE below.
#   "file"   a CSV file per collection, laid out as a tab (see compose.demo.yaml).
# SQUAREPOT_STORE=link

# Collections, as a JSON list. `id` is a short stable name in lower-case
# letters, digits, "-" or "_", and `spreadsheet_id` is the long id in the
# sheet's URL (docs.google.com/spreadsheets/d/<spreadsheet_id>/edit).
# With "link", `gid` chooses the tab: the number after "#gid=" in the tab's URL;
# without it, the first tab is read.
SQUAREPOT_COLLECTIONS='[{"id": "main", "name": "My plants", "spreadsheet_id": "PUT-THE-SPREADSHEET-ID-HERE"}]'
# With "google", each collection names its tab with "sheet" instead:
# SQUAREPOT_COLLECTIONS='[{"id": "main", "name": "My plants", "spreadsheet_id": "PUT-THE-SPREADSHEET-ID-HERE", "sheet": "Plants"}]'
# With "file", each collection has a "file", the path of its CSV file inside
# the container:
# SQUAREPOT_COLLECTIONS='[{"id": "demo", "name": "Demo plants", "file": "/demo/plants.csv"}]'

# How often to check the sheets for changes, in seconds. With "link", each
# check downloads the tab (about 100 bytes per plant). With "google", it is one
# cheap Drive call per collection, and a changed tab is read with one Sheets
# call. 0 turns syncing off.
SQUAREPOT_SYNC_INTERVAL_SECONDS=60

# Serve the interactive API docs at /docs and /redoc, and the schema at
# /openapi.json, for development. Off by default: the API contract is
# server/openapi.json in the repository.
# SQUAREPOT_API_DOCS=false

# Database. The default is SQLite in the container's data volume.
# SQUAREPOT_DATABASE_URL=sqlite:////data/squarepot.db

# Where plant photos are kept (ADR 0007):
#   "none" (the default) no photos;
#   "disk" a folder in the data volume, served by the server at addresses it signs;
#   "s3"   a private bucket of an S3-compatible service, such as Yandex Object
#          Storage; also set COMPOSE_FILE below and the S3 settings.
# SQUAREPOT_PHOTOS=none
# The folder for "disk".
# SQUAREPOT_PHOTOS_DIR=/data/photos
# The service, its region and the bucket for "s3". The bucket's own versioning
# and lifecycle rules are its backup.
# SQUAREPOT_S3_ENDPOINT=https://storage.yandexcloud.net
# SQUAREPOT_S3_REGION=ru-central1
# SQUAREPOT_S3_BUCKET=
# The key for "s3", inside the container; compose.photos.yaml mounts it there.
# SQUAREPOT_S3_KEY_FILE=/run/secrets/photos-key

# --- docker compose only ---

# The server image. Unset, `docker compose up --build` builds it from this
# repository. To pull the image CI publishes from main instead (a build needs
# more memory than a small host has), set it to the commit's tag or to "main":
# SQUAREPOT_IMAGE=ghcr.io/square-pot/squarepot-server:main

# Addresses of reverse proxies whose X-Forwarded-For header is believed, so
# that the server sees each client's own address (for backing off clients
# that keep sending a wrong token). The default trusts Docker's own networks,
# through which a proxy on the host, such as Caddy, reaches the container.
# Comma-separated addresses or networks. If the server listens on your network
# (SQUAREPOT_LISTEN=0.0.0.0:8000) with no proxy in front, and that network uses
# 172.16-172.31 addresses, set this to the Docker network alone (see
# `docker network inspect squarepot_default`), or a client there could claim
# another address.
# SQUAREPOT_TRUSTED_PROXIES=172.16.0.0/12

# The most memory the server may use. Above it the kernel stops the server and
# Docker starts it again.
# SQUAREPOT_MEMORY_LIMIT=1g

# With SQUAREPOT_STORE=google, add the service account's key to the stack:
# COMPOSE_FILE=compose.yaml:compose.google.yaml

# Host file holding the service account's JSON key; compose.google.yaml passes
# it to the server as a secret. Default: service-account.json next to compose.yaml.
# SQUAREPOT_GOOGLE_KEY_FILE=./service-account.json
# With SQUAREPOT_PHOTOS=s3, add the bucket's key to the stack too:
# COMPOSE_FILE=compose.yaml:compose.photos.yaml (or ...:compose.google.yaml:compose.photos.yaml)
# Host file holding the key: the key id on its first line, the secret on its
# second. Default: photos-key next to compose.yaml.
# SQUAREPOT_PHOTOS_KEY_FILE=./photos-key

# Address and port the API listens on, on the host. The default accepts local
# connections only; use 0.0.0.0:8000 to reach it from a phone on your network.
# Until HTTPS is set up, do not expose it to the internet.
# SQUAREPOT_LISTEN=127.0.0.1:8000
