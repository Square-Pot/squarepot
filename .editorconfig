# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = intellij_idea
# Composable functions are PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
# List continuation lines align with the item text, not with an indent step.
indent_size = unset

[Makefile]
indent_style = tab
